#X obj 500 332 print gaia.acc.x;
#X obj 20 370 r gaia.acc.y;
#X obj 20 397 print gaia.acc.y;
#X obj 260 370 r gaia.acc.z;
#X obj 260 397 print gaia.acc.z;
#X obj 500 370 r gaia.quat;
#X obj 500 397 print gaia.quat;
