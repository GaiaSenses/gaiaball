#N canvas 40 40 760 560 12;
#X text 20 10 e2e: prints the [gaiaball] status and every gaia.* channel on the console. Run with: pd -nogui -stderr -path pd-gaiaball -open pd-gaiaball/tests/e2e/listen.pd \, then node pd-gaiaball/tests/e2e/send-goldens.mjs, f 96;
#N canvas 80 80 300 140 first 0;
#X obj 20 20 gaiaball;
#X obj 20 50 print gaiaball;
#X connect 0 0 1 0;
#X restore 20 80 pd first;
#X obj 300 80 gaiaball;
#X obj 300 110 print gaiaball2;
#X text 440 80 <- same port: logs "porta 9478 em uso" once \, then takes over when [pd first] is cleared, f 40;
#X obj 20 130 netreceive 9479;
#X obj 20 160 route clear;
#X msg 20 190 \; pd-first clear;
#X text 140 130 <- the message clear (FUDI over TCP 9479) from send-goldens.mjs deletes the first [gaiaball], f 40;
#X obj 20 240 r gaia.lat;
#X obj 20 267 print gaia.lat;
#X obj 260 240 r gaia.lon;
#X obj 260 267 print gaia.lon;
