#N canvas 40 40 760 520 12;
#X text 20 10 e2e: prints the [gaiaball] status and every gaia.* channel on the console. Run with: pd -nogui -stderr -path pd-gaiaball -open pd-gaiaball/tests/e2e/listen.pd \, then node pd-gaiaball/tests/e2e/send-goldens.mjs, f 96;
#X obj 20 80 gaiaball;
#X obj 20 110 print gaiaball;
#X obj 300 80 gaiaball;
#X text 380 80 <- same port: must log "porta 9478 em uso" and stay inert, f 40;
