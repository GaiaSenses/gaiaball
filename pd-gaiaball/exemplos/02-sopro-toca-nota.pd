#N canvas 40 40 900 760 12;
#X text 20 12 EXEMPLO 2 - O SOPRO TOCA UMA NOTA. Cada sopro que a bola reconhece toca uma nota com ataque rápido e final suave. Sem bola? Clique no botão de teste ou abra a config-app com ?demo=1 no fim do endereço (ela simula um sopro a cada 6 segundos)., f 120;
#X text 20 70 1) Ligue o som do Pd: clique em dsp 1 (atalho Ctrl+/). Para desligar \, clique em dsp 0 ao lado. Comece com o volume do computador baixo., f 52;
#X msg 20 130 \; pd dsp 1;
#X msg 120 130 \; pd dsp 0;
#X obj 600 70 gaiaball;
#X obj 600 100 route connected;
#X obj 600 130 tgl 20 0 empty empty empty 0 -8 0 12 -262144 -1 -1 0 1;
#X text 628 130 1 = conectado, f 16;
#X text 600 160 Se outro patch aberto já tem um [gaiaball] \, o console pode mostrar 'Address already in use': tudo bem \, os dados chegam pelo outro. Se você fechar o outro \, clique neste [gaiaball] (fora do modo de edição) e em reconectar., f 34;
#X text 20 180 2) A nota em número MIDI (60 = dó central). Arraste o número para mudar., f 36;
#X obj 20 236 loadbang;
#X msg 20 264 64;
#X floatatom 20 292 5 0 0 0 - - -;
#X obj 20 320 mtof;
#X obj 20 348 osc~;
#X text 320 180 3) gaia.breath vale 1 enquanto dura o sopro e chega 50 vezes por segundo. [change] só deixa passar as mudanças e [sel 1] dá um bang quando o sopro começa., f 38;
#X obj 320 270 r gaia.breath;
#X obj 320 298 change;
#X obj 320 326 sel 1;
#X obj 320 356 bng 20 250 50 0 empty empty empty 0 -8 0 12 -262144 -1 -1;
#X obj 440 356 bng 20 250 50 0 empty empty empty 0 -8 0 12 -262144 -1 -1;
#X text 466 356 teste sem bola, f 16;
#X msg 320 392 1 10 \, 0 1500 10;
#X obj 320 422 vline~;
#X text 320 456 O envelope: sobe até 1 em 10 ms e depois desce até 0 em 1500 ms. Mude os números para notas mais curtas ou mais longas., f 38;
#X obj 20 470 *~;
#X text 600 400 Volume geral (0 = mudo \, 1 = máximo), f 36;
#X obj 600 440 loadbang;
#X msg 600 468 0.2;
#X obj 600 498 hsl 160 18 0 1 0 0 empty empty empty -2 -8 0 12 -262144 -1 -1 0 1;
#X msg 600 526 \$1 50;
#X obj 600 554 line~;
#X obj 20 600 *~;
#X obj 20 640 dac~;
#X text 80 470 nota x envelope, f 20;
#X text 80 600 x volume geral, f 20;
#X text 80 640 saída: esquerda e direita, f 30;
#X text 20 690 Experimente: troque [osc~] por [phasor~] (som mais brilhante) ou faça a altura depender do sopro anterior. A bola só reconhece um sopro novo 3 segundos depois do anterior (padrão da bola)., f 120;
