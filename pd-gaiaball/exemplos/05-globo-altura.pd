#N canvas 40 40 980 870 12;
#X text 20 12 EXEMPLO 5 - O GLOBO VIRA MÚSICA. Girar a bola move o globo virtual. A latitude (norte-sul) escolhe a nota \, a longitude (leste-oeste) leva o som da esquerda para a direita e \, quando o globo para \, toca um sino. Precisa da navegação ligada na bola (Espelho \, o padrão \, ou Joystick)., f 130;
#X text 20 70 1) Ligue o som do Pd: clique em dsp 1 (atalho Ctrl+/). Para desligar \, clique em dsp 0 ao lado. Comece com o volume do computador baixo., f 52;
#X msg 20 130 \; pd dsp 1;
#X msg 120 130 \; pd dsp 0;
#X obj 680 70 gaiaball;
#X obj 680 100 route connected;
#X obj 680 130 tgl 20 0 empty empty empty 0 -8 0 12 -262144 -1 -1 0 1;
#X text 708 130 1 = conectado, f 16;
#X text 680 160 Se outro patch aberto já tem um [gaiaball] \, este avisa porta 9478 em uso no console: tudo bem \, os dados chegam do mesmo jeito., f 34;
#X text 20 190 Volume geral (0 = mudo \, 1 = máximo), f 26;
#X obj 20 230 loadbang;
#X msg 20 258 0.2;
#X obj 20 288 hsl 160 18 0 1 0 0 empty empty empty -2 -8 0 12 -262144 -1 -1 0 1;
#X msg 20 316 \$1 50;
#X obj 20 344 line~;
#X text 230 190 2) Latitude -90 a 90 vira nota MIDI (de 48 a 96). [int] arredonda para semitons e [change] ignora repetições., f 30;
#X obj 230 286 r gaia.lat;
#X floatatom 230 314 8 0 0 0 - - -;
#X obj 230 342 + 90;
#X obj 230 370 / 180;
#X obj 230 398 * 48;
#X obj 230 426 + 48;
#X obj 230 454 int;
#X obj 230 482 change;
#X floatatom 230 510 4 0 0 0 - - -;
#X obj 230 538 mtof;
#X msg 230 566 \$1 40;
#X obj 230 594 line~;
#X obj 230 622 osc~;
#X text 300 510 nota, f 6;
#X text 290 566 desliza em 40 ms, f 18;
#X obj 20 664 *~;
#X text 60 664 som x volume, f 14;
#X text 470 190 3) Longitude -180 a 180 vira posição 0 (esquerda) a 1 (direita). Na linha de data (180 graus) o som pula de um lado para o outro., f 30;
#X obj 470 286 r gaia.lon;
#X floatatom 470 314 8 0 0 0 - - -;
#X obj 470 342 + 180;
#X obj 470 370 / 360;
#X floatatom 470 398 5 0 0 0 - - -;
#X msg 470 426 \$1 50;
#X obj 470 454 line~;
#X text 520 398 posição, f 10;
#X obj 230 704 *~;
#X obj 20 744 -~;
#X obj 20 784 dac~;
#X text 270 704 direita = som x posição, f 26;
#X text 60 744 esquerda = som - direita, f 26;
#X text 60 784 saída, f 10;
#X text 700 330 4) gaia.settled vira 1 quando o globo para. Chega 50 vezes por segundo: [change] e [sel 1] fazem um bang só \, na hora em que ele para., f 36;
#X obj 700 402 r gaia.settled;
#X obj 700 430 change;
#X obj 700 458 sel 1;
#X obj 700 488 bng 20 250 50 0 empty empty empty 0 -8 0 12 -262144 -1 -1;
#X msg 700 524 1 5 \, 0 600 5;
#X obj 700 552 vline~;
#X obj 800 552 osc~ 1320;
#X obj 700 590 *~;
#X obj 700 620 *~ 0.1;
#X obj 700 650 dac~;
#X text 760 620 o sino tem volume fixo, f 24;
#X text 760 650 vários [dac~] se somam, f 24;
#X text 470 744 Na posição de referência o globo mostra Campinas (lat -22.9 e lon -47.06). Se o site do GaiaSenses estiver conectado à bola \, a conexão dele também zera a bola e o globo passa a começar no ponto que o mapa do site mostra. Sem bola: no modo demo (?demo=1) a latitude e a longitude passeiam devagar e o globo para a cada 10 segundos., f 70;
