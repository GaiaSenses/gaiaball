#N canvas 40 40 760 420 12;
#X text 20 10 e2e: prints every gaia.* channel and gaiaball.status on Pd's console. Opened by e2e.mjs next to ../gaiaball.pd (or objeto.pd), f 90;
#X obj 20 60 r gaia.lat;
#X obj 20 87 print gaia.lat;
#X obj 260 60 r gaia.lon;
#X obj 260 87 print gaia.lon;
#X obj 500 60 r gaia.speed;
#X obj 500 87 print gaia.speed;
#X obj 20 125 r gaia.bearing;
#X obj 20 152 print gaia.bearing;
#X obj 260 125 r gaia.settled;
#X obj 260 152 print gaia.settled;
#X obj 500 125 r gaia.acc.x;
#X obj 500 152 print gaia.acc.x;
#X obj 20 190 r gaia.acc.y;
#X obj 20 217 print gaia.acc.y;
#X obj 260 190 r gaia.acc.z;
#X obj 260 217 print gaia.acc.z;
#X obj 500 190 r gaia.quat;
#X obj 500 217 print gaia.quat;
#X obj 20 255 r gaia.mic.rms;
#X obj 20 282 print gaia.mic.rms;
#X obj 260 255 r gaia.mic.peak;
#X obj 260 282 print gaia.mic.peak;
#X obj 500 255 r gaia.breath;
#X obj 500 282 print gaia.breath;
#X obj 20 320 r gaia.sensors;
#X obj 20 347 print gaia.sensors;
#X obj 260 320 r gaia.co2;
#X obj 260 347 print gaia.co2;
#X obj 500 320 r gaia.co2.trigger;
#X obj 500 347 print gaia.co2.trigger;
#X obj 20 385 r gaiaball.status;
#X obj 20 412 print gaiaball;
#X connect 1 0 2 0;
#X connect 3 0 4 0;
#X connect 5 0 6 0;
#X connect 7 0 8 0;
#X connect 9 0 10 0;
#X connect 11 0 12 0;
#X connect 13 0 14 0;
#X connect 15 0 16 0;
#X connect 17 0 18 0;
#X connect 19 0 20 0;
#X connect 21 0 22 0;
#X connect 23 0 24 0;
#X connect 25 0 26 0;
#X connect 27 0 28 0;
#X connect 29 0 30 0;
#X connect 31 0 32 0;
