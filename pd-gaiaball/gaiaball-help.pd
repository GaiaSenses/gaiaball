#N canvas 40 40 1000 700 10;
#X obj 40 300 gaiaball;
#X obj 40 360 unpack f f f;
#X floatatom 40 390 8 0 0 0 - - -;
#X floatatom 110 390 8 0 0 0 - - -;
#X floatatom 180 390 8 0 0 0 - - -;
#X obj 260 330 print quat;
#X obj 330 360 unpack f f f;
#X floatatom 330 390 8 0 0 0 - - -;
#X floatatom 400 390 8 0 0 0 - - -;
#X floatatom 470 390 8 0 0 0 - - -;
#X obj 40 470 unpack f f f f f;
#X floatatom 40 500 6 0 0 0 - - -;
#X floatatom 100 500 4 0 0 0 - - -;
#X floatatom 150 500 4 0 0 0 - - -;
#X floatatom 200 500 4 0 0 0 - - -;
#X floatatom 250 500 5 0 0 0 - - -;
#X obj 330 470 unpack f f;
#X floatatom 330 500 7 0 0 0 - - -;
#X floatatom 400 500 7 0 0 0 - - -;
#X obj 480 470 unpack f;
#X floatatom 480 500 6 0 0 0 - - -;
#X obj 570 430 print diag;
#X obj 650 430 print audio;
#X obj 730 430 print status;
#X obj 40 560 sel 1;
#X obj 40 590 print SOPRO;
#X obj 620 560 osc~;
#X obj 620 440 + 180;
#X obj 620 470 * 1.5;
#X obj 620 500 + 120;
#X msg 700 520 0.1;
#X msg 740 520 0;
#X obj 620 600 *~;
#X obj 620 630 dac~;
#X text 40 20 [gaiaball] - todos os dados da Gaiaball no Pure Data (somente leitura);
#X text 40 45 1) rode a ponte no terminal: python gaiaball_bridge.py;
#X text 40 65 2) ligue a bola. A ponte acha e conecta sozinha (status mostra connected);
#X text 40 85 3) os 9 outlets abaixo entregam cada grupo de dados ja decodificado.;
#X text 40 120 Outlets da esquerda para a direita:;
#X text 40 140 1 euler: roll pitch yaw em graus (convencao legada - a mesma que o site entrega ao patch Pd);
#X text 40 160 2 quat: w x y z normalizado. 3 accel: contagens cruas (g = valor/8192);
#X text 40 180 4 co2: ppm valido velho virtual idade_s. 5 mics: dBFS_L dBFS_R rms_L rms_R filtrado;
#X text 40 200 6 pot: porcento cru limiar_rms controla. 7 diag: uptime hz_imu hz_notify erros heap ok-flags;
#X text 40 220 8 audio: 96 amostras int16 a 2 kHz (so com a ponte em --audio). 9 status: scanning connected disconnected;
#X text 40 415 roll / pitch / yaw (graus);
#X text 330 415 accel x y z (cru);
#X text 40 525 ppm valido velho virtual idade;
#X text 330 525 mics dBFS L / R;
#X text 480 525 pot %;
#X text 110 560 <- pulso virtual ativo = sopro detectado;
#X text 620 410 exemplo sonoro: yaw vira frequencia;
#X text 700 495 <- clique 0.1 para ouvir e 0 para calar;
